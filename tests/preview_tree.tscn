script = ExtResource("5_mascot")
slot = "mascot_scout"
; The map-reading scout, mounted through world/mascot.gd rather than as a
; plain .glb: the node builds the model with the game's own toon materials,
; blinks by itself and can be told to talk, and his map sways in the shader.
; Standing left of the trunk at the scale that puts a 1.07-tall mascot beside
; a 2.6-scaled oak.

[node name="Grass" type="Node3D" parent="."]
; The grass field's tufts (grass_patch, 80 strands baked from the source hair),
; one every half cell with a little jitter, as a MultiMesh would stand them in the game.

