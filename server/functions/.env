# Read by `firebase deploy` into every function's environment (not secret).
# The daily theme's pictures (themeday.ts, the themeDay job): pixel art,
# drawn on Vertex AI in navlio's production-506015, whose Vertex AI User
# role the functions' service account is granted by tools/vertex_identity.sh.
DAILY_PICTURE_STYLE=pixel
# VERTEX_PROJECT=production-506015
# DAILY_IMAGE_MODEL=gemini-3-pro-image

# The Neon flow (2026-11-02, tools/neon_day.sh): Claude and gpt-image-2 through
# the peeplet project's ai-gateway branch. The token is the secret
# NEON_AI_GATEWAY_TOKEN. Vertex above is off while these stand.
NEON_AI_GATEWAY_BASE_URL=https://br-blue-hat-aiz05awv-api.ai.c-4.us-east-1.aws.neon.tech
DAILY_IMAGE_MODEL=neon/gpt-image-2
DAILY_SHAPES_MODEL=neon/gpt-image-2
DAILY_MODEL=anthropic/claude-haiku-5.5
DAILY_REVIEW_MODEL=anthropic/claude-sonnet-5.5
DAILY_ROWS_MODEL=anthropic/claude-sonnet-5.5
DAILY_FINAL_MODEL=anthropic/claude-opus-5.5
DAILY_MAP_TIERS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5,anthropic/claude-opus-5.5
