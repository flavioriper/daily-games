# Godot 4 generated files
.godot/
/android/
*.translation

# macOS
.DS_Store

# Local session history from the Remember plugin, not project state
.remember/

# Blender backups
*.blend1

# Blender by-product of tools/build_pieces.py; the script is the source
art/*.blend
# Mascots are modelled by hand, so their .blend IS the source: keep it
!art/mascot_*.blend
# So is the tile cube, hand-modelled since the trilon was replaced
!art/tile.blend
# So is the tree, hand-modelled scenery
!art/tree.blend
# So are Code Break's socket, peg, pip and lid
!art/codebreak.blend
# So are the Pipes pad, pipe shapes and valve
!art/pipes.blend
# Balance: ten hand-modelled collections (the scale's three parts, the plinth,
# the weight disc and the five shape tokens).
!art/balance.blend
# Untangle: the mooring post. The rope is not a model -- the board builds it.
!art/untangle.blend
# Shikaku's plot floor, dry-stone wall, corner post and marker stone.
!art/shikaku.blend
# Tents: the turf cell, the conifer, the tent and the cairn.
!art/tents.blend
# Light Up: the wall block with its carved numerals, and the lantern. The
# court's flagstones are Shikaku's plot_pad and the chip that rules a cell out
# is Tents' cairn, so neither is modelled here.
!art/lightup.blend
# Nonogram's mosaic tile and One Line's plank. Both boards borrow everything
# else they stand on from Shikaku, Tents and Untangle.
!art/grids.blend
# Horse Pen: the horse, the fence and the apple, each cut down from a
# BlenderKit asset in Blender and kept as the source.
!art/horse.blend
# Snake Apple: the snake head cut from a BlenderKit asset, and the burrow.
!art/snake.blend
# Code Break's screen: the deck strip and the scenery around the dock.
!art/scenery.blend
# The menu's carved title sign: one plank, leaves and screws, with the title
# and motto as Text objects tools/build_signs.py swaps per puzzle. Modelled in
# the live session, so this .blend is the source of all twelve signs.
!art/sign.blend
!art/camp_sign.blend
# Two pieces of the peeplet project's valley, brought over as geometry: the
# copy of its trees.blend they were cut from, and the two cut-down sources.
!art/peeplet_trees.blend
!art/oak.blend
!art/grass_clump.blend
# And the BlenderKit grass field the grass_patch is baked from
!art/grassfield.blend

# Python bytecode from running the tools
__pycache__/

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# BlenderKit keeps a local copy of every downloaded asset beside the .blend
# it was pulled into; the cut-down model in the tracked .blend is the source.
art/assets/

# Android export output; tools/deploy_android.sh rebuilds it
/build/

# The GA4 Measurement Protocol secret the game ships with: machine-local,
# packed by the export preset, never in git.
analytics_secret.cfg
# The Ghibli-style painted landscape the whole game sits in: the meadow with
# its basin, the grass baked down from the original hair particles, and the
# cloud, tree and blossom cards. Not rebuildable by a script -- the source file
# came in by hand and was cut to the contract in the live session.
!art/landscape.blend

server/functions/node_modules/
server/functions/lib/
server/.firebase/
# Dropped by the Firebase emulator suite on every run; not project state.
# The glob, because the suite names a new one for every service it starts
# (firebase-debug.log turned up the first time the functions emulator ran).
server/*.log
