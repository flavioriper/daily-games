# Godot 4 generated files
.godot/
/android/
*.translation

# macOS
.DS_Store

# Local session history from the Remember plugin, not project state
.remember/

# Blender backups
*.blend1

# Blender by-product of tools/build_pieces.py; the script is the source
art/*.blend
# Mascots are modelled by hand, so their .blend IS the source: keep it
!art/mascot_*.blend
# So is the tile cube, hand-modelled since the trilon was replaced
!art/tile.blend
# So is the tree, hand-modelled scenery
!art/tree.blend
# So are Code Break's socket, peg, pip and lid
!art/codebreak.blend
# So are the Pipes pad, pipe shapes and valve
!art/pipes.blend
# Balance: ten hand-modelled collections (the scale's three parts, the plinth,
# the weight disc and the five shape tokens).
!art/balance.blend
# Untangle: the mooring post. The rope is not a model -- the board builds it.
!art/untangle.blend
# Shikaku's plot floor, dry-stone wall, corner post and marker stone.
!art/shikaku.blend
# Tents: the turf cell, the conifer, the tent and the cairn.
!art/tents.blend
# Light Up: the wall block with its carved numerals, and the lantern. The
# court's flagstones are Shikaku's plot_pad and the chip that rules a cell out
# is Tents' cairn, so neither is modelled here.
!art/lightup.blend
# Nonogram's mosaic tile and One Line's plank. Both boards borrow everything
# else they stand on from Shikaku, Tents and Untangle.
!art/grids.blend

# Python bytecode from running the tools
__pycache__/

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
