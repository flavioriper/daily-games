; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-1208368368327333~1757126681"
general/ios/app_id="ca-app-pub-1208368368327333~6103565803"

[ads]

banner_unit_id=""
banner_unit_id.android="ca-app-pub-1208368368327333/2355892480"
banner_unit_id.ios="ca-app-pub-1208368368327333/2084429742"
interstitial_unit_id.android="ca-app-pub-1208368368327333/2741005484"
interstitial_unit_id.ios="ca-app-pub-1208368368327333/8387335403"
rewarded_unit_id.android="ca-app-pub-1208368368327333/3155938459"
rewarded_unit_id.ios="ca-app-pub-1208368368327333/8368911697"

[application]

config/name="Peeplet Daily"
config/description="A handful of calm puzzles, new every day"
run/main_scene="res://world/boot.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.988235, 0.960784, 0.913725, 1)
boot_splash/show_image=false
config/icon="res://assets/icon/icon.png"

[autoload]

MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"
Store="*res://core/store.gd"
Ads="*res://core/ads.gd"
Wallet="*res://core/wallet.gd"
Stock="*res://core/stock.gd"
GodotIapPlugin="*uid://c8xt82r1xtwn0"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/godot-iap/plugin.cfg")

[godot_mcp]

bind_mode=0
custom_bind_ip=""
port_override_enabled=false
port_override=6550

[input_devices]

pointing/emulate_mouse_from_touch=false

[internationalization]

locale/translations=PackedStringArray("res://locale/turn.en.translation", "res://locale/turn.pt.translation", "res://locale/turn.es.translation", "res://locale/ui.en.translation", "res://locale/ui.pt.translation", "res://locale/ui.es.translation", "res://locale/boards.en.translation", "res://locale/boards.pt.translation", "res://locale/boards.es.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.749, 0.89, 0.961, 1)

[shader_globals]

motion_scale={
"type": "float",
"value": 1.0
}
wind_gust={
"type": "float",
"value": 0.0
}
